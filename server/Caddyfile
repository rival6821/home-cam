###############################################################################
# Caddyfile — 홈캠 릴레이 마스터플랜 §5.1(4단계) / §5.2
#
# 정적 파일(camera.html, index.html)과 MediaMTX의 WHIP/WHEP을 동일 출처(HTTPS)로
# 통합해 CORS·혼합 콘텐츠 문제를 원천 제거한다. TLS는 Caddy 자체 ACME가 아니라
# Tailscale이 발급한 인증서를 사용한다(setup.sh / cert-renew.sh 참고).
#
# 포트는 기본 443이지만 고정값이 아니다 — 접근 자체가 Tailscale로 걸러지므로
# 443이어야 할 이유가 없고, 그 VPS를 다른 서비스와 같이 쓰는 중이라 443이 이미
# 점유돼 있으면(예: 기존 nginx) setup.sh 두 번째 인자로 다른 포트를 지정하면
# 된다 — 아래 포트 자리표시자는 그때 자동 치환된다.
#
# 배포 위치: /etc/homecam/Caddyfile (docker-compose.yml이 caddy 컨테이너 안
# /etc/caddy/Caddyfile로 읽기전용 마운트한다 — setup.sh가 아래 자리표시자를
# 실제 호스트명·포트로 치환해 이 경로에 생성한다). 수정 후 반영은
#   docker exec homecam-caddy caddy reload --config /etc/caddy/Caddyfile
###############################################################################

# ⚠ 실제 tailnet 호스트명·포트로 교체 (예: cam-vps.tail1a2b3.ts.net:443)
YOUR-HOST.tailXXXXX.ts.net:HOMECAM_PORT_PLACEHOLDER {

	tls /etc/homecam/certs/YOUR-HOST.tailXXXXX.ts.net.crt \
	    /etc/homecam/certs/YOUR-HOST.tailXXXXX.ts.net.key

	encode zstd gzip

	# §5.2 보안 헤더
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(self), microphone=(self)"
		# script-src/style-src에 'unsafe-inline'이 있는 이유: camera.html·index.html이
		# 외부 파일 없이 <style>/<script>를 인라인으로 담은 "단일 파일 웹앱"이기 때문
		# (마스터플랜의 명시적 설계 원칙). manifest-src data:는 PWA 매니페스트를
		# data: URI로 인라인했기 때문에 필요하다.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; manifest-src data:; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# §1.2 WHIP/WHEP — MediaMTX로 프록시. "mediamtx"는 컨테이너 이름이 아니라
	# docker-compose.yml의 서비스 이름으로, 같은 internal 브리지 네트워크 안에서
	# Docker 내장 DNS가 이 이름을 mediamtx 컨테이너의 IP로 풀어준다(호스트도
	# 아니고 127.0.0.1도 아니다 — 컨테이너는 서로 별도의 네트워크 네임스페이스).
	# 경로 뒤 세그먼트(/whip/<session-id> 등, DELETE 종료용)까지 함께 넘기도록
	# 끝을 앵커하지 않는다 — mediamtx가 리버스 프록시 뒤에서 Location 헤더에
	# 부가 경로를 붙여 돌려주는 경우까지 대비한 것(github.com/bluenviron/mediamtx
	# issues #4504, #3649 참고). 원본 Host 헤더를 명시적으로 전달해 mediamtx가
	# 내부 바인드 주소가 아닌 공개 호스트명을 인지하도록 한다.
	@media path_regexp ^/[A-Za-z0-9_-]+/(whip|whep)(/.*)?$
	handle @media {
		reverse_proxy mediamtx:8889 {
			header_up Host {host}
		}
	}

	# 그 외 요청은 정적 파일(뷰어=index.html, 카메라=camera.html) 서빙.
	handle {
		root * /var/www/homecam
		file_server
	}
}
